{
  "name": "koishi-plugin-chatluna-livingmemory",
  "version": "0.1.3",
  "contributors": [
    "ProcyonNAN <3189960265@qq.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Procyon-Nan/koishi-plugin-chatluna-livingmemory.git"
  },
  "type": "module",
  "description": "ChatLuna plugin example",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "client",
    "resources"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "chatluna",
    "koishi",
    "plugin",
    "memory"
  ],
  "dependencies": {
    "@langchain/core": "0.3.62"
  },
  "resolutions": {
    "@langchain/core": "0.3.62",
    "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
  },
  "overrides": {
    "@langchain/core": "0.3.62",
    "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "0.3.62",
      "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    }
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-console": "^5.30.11",
    "@typescript-eslint/eslint-plugin": "^7.18.1-alpha.3",
    "@typescript-eslint/parser": "^8.45.1-alpha.0",
    "atsc": "^1.2.2",
    "esbuild": "^0.25.10",
    "esbuild-register": "^3.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.4.0-alpha.10",
    "yakumo": "^1.0.0",
    "yakumo-esbuild": "^1.0.0",
    "yakumo-mocha": "^1.0.0",
    "yakumo-tsc": "^1.0.0"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:server": "yarn yakumo build",
    "build:client": "koishi-console build",
    "build": "yarn build:server && yarn build:client",
    "bump": "yarn yakumo version",
    "dep": "yarn yakumo upgrade",
    "pub": "yarn yakumo publish",
    "lint": "yarn eslint src --ext=ts",
    "lint-fix": "yarn eslint src --ext=ts --fix"
  },
  "koishi": {
    "description": {
      "zh": "适用于chatluna的长期记忆插件，提供记忆的异步召回、提取与 WebUI 管理能力"
    },
    "service": {
      "required": [
        "chatluna",
        "database"
      ],
      "optional": [
        "console",
        "chatluna_character"
      ]
    },
    "browser": true,
    "icon": "mdi:brain"
  }
}
